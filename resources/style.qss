/* Resin MeasureWare - Application Stylesheet */

/* Global */
* {
    font-family: "Microsoft YaHei", "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #FAFAFA;
}

/* Menu bar */
QMenuBar {
    background-color: #37474F;
    color: white;
    padding: 2px;
}

QMenuBar::item:selected {
    background-color: #546E7A;
}

QMenu {
    background-color: white;
    border: 1px solid #BDBDBD;
}

QMenu::item:selected {
    background-color: #E3F2FD;
    color: #1565C0;
}

/* Group boxes */
QGroupBox {
    font-weight: bold;
    border: 1px solid #E0E0E0;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 16px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #37474F;
}

/* Input fields */
QLineEdit, QSpinBox, QComboBox {
    padding: 4px 6px;
    border: 1px solid #BDBDBD;
    border-radius: 3px;
    background-color: white;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: #2196F3;
}

QLineEdit:disabled, QSpinBox:disabled, QComboBox:disabled {
    background-color: #F5F5F5;
    color: #9E9E9E;
}

/* Buttons */
QPushButton {
    padding: 6px 16px;
    border: 1px solid #BDBDBD;
    border-radius: 4px;
    background-color: #FAFAFA;
}

QPushButton:hover {
    background-color: #EEEEEE;
}

QPushButton:pressed {
    background-color: #E0E0E0;
}

QPushButton:disabled {
    background-color: #F5F5F5;
    color: #BDBDBD;
}

/* Table */
QTableView {
    gridline-color: #E0E0E0;
    selection-background-color: #BBDEFB;
    selection-color: #212121;
    border: 1px solid #E0E0E0;
}

QTableView::item {
    padding: 3px 5px;
}

QHeaderView::section {
    background-color: #ECEFF1;
    color: #37474F;
    font-weight: bold;
    padding: 4px 6px;
    border: 1px solid #CFD8DC;
}

/* Splitter */
QSplitter::handle {
    background-color: #E0E0E0;
    margin: 2px 0;
}

QSplitter::handle:horizontal {
    width: 3px;
}

QSplitter::handle:vertical {
    height: 3px;
}

/* Status bar */
QStatusBar {
    background-color: #ECEFF1;
    border-top: 1px solid #CFD8DC;
    padding: 2px 6px;
}

/* Tab widget */
QTabWidget::pane {
    border: 1px solid #E0E0E0;
    background-color: white;
}

QTabBar::tab {
    padding: 6px 16px;
    border: 1px solid #E0E0E0;
    border-bottom: none;
    background-color: #F5F5F5;
}

QTabBar::tab:selected {
    background-color: white;
    font-weight: bold;
}

/* Dialog */
QDialog {
    background-color: #FAFAFA;
}
